{
  "name": "berth-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Official website for Berth — local AI Agent asset manager",
  "scripts": {
    "dev": "vite-react-ssg dev --host",
    "build": "vite-react-ssg build && node scripts/postbuild.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "i18next": "^26.3.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.30.4",
    "tailwind-merge": "^3.6.0",
    "vite-react-ssg": "0.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
