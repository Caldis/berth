{
  "name": "berth",
  "version": "0.4.2",
  "description": "Local AI Agent asset visualization and management tool",
  "author": "Caldis",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "homepage": "https://github.com/user/berth",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:agent": "node scripts/agent-dev.mjs",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-vite build && electron-builder --publish never",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "knip": "knip",
    "knip:ci": "knip --no-exit-code",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:test",
    "harness:sync": "node scripts/harness-sync.mjs",
    "harness:check": "node scripts/harness-check.mjs",
    "harness:ci:baseline": "node scripts/harness-ci-gate.mjs baseline",
    "harness:ci:wait": "node scripts/harness-ci-gate.mjs wait",
    "harness:stats": "node scripts/harness-stats.mjs",
    "harness:issues": "node scripts/harness-issues.mjs",
    "harness:projects:check": "node scripts/harness-projects.mjs check",
    "harness:prepush": "node scripts/harness-prepush.mjs",
    "pricing:update": "node scripts/update-pricing-catalog.mjs",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.3",
    "glob": "^11.0.0",
    "ignore": "^7.0.5",
    "js-yaml": "^4.1.0",
    "minisearch": "^7.1.1",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.39.4",
    "@floating-ui/react": "^0.27.19",
    "@heroui/react": "2.8.10",
    "@heroui/theme": "2.4.26",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "framer-motion": "^12.40.0",
    "globals": "^15.14.0",
    "i18next": "^24.2.0",
    "jsdom": "^25.0.1",
    "knip": "^6.17.1",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.1.0",
    "react-virtuoso": "^4.18.7",
    "recharts": "^2.15.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "zustand": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
