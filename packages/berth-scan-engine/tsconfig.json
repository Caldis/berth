{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "comment": "cli/engine-bridge import the in-place repo engine (@shared + ../../../src); typechecked at the repo + validated via tsup build, vitest and E2E. Migrated into the package in P2.",
  "exclude": [
    "dist",
    "node_modules",
    "tests",
    "src/cli.ts",
    "src/cli-bin.ts",
    "src/engine-bridge.ts"
  ]
}
