{
  "name": "@berth/scan-engine",
  "version": "0.1.0",
  "description": "Read-only asset discovery & introspection engine for Claude Code and Codex. Powers the berth UI, a standalone CLI, and agent integrations.",
  "author": "Caldis",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "berth-scan": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapter-api": {
      "types": "./dist/adapter-api.d.ts",
      "import": "./dist/adapter-api.js",
      "require": "./dist/adapter-api.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
